# Copie este arquivo para .env e ajuste os valores.
# Nunca commite o arquivo .env com valores reais.

# Chave secreta usada para sessões e CSRF. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Ativa o modo debug do Flask (NUNCA use "1" em produção).
FLASK_DEBUG=0

# String de conexão do banco de dados (padrão: SQLite local).
# Em produção, prefira PostgreSQL/MySQL, ex:
#   DATABASE_URL=postgresql://usuario:senha@host:5432/claviculario
DATABASE_URL=sqlite:///banco_v3.db

# Máximo de sessões simultâneas por usuário.
MAX_SESSOES_POR_USUARIO=10

# Defina como 1 quando a aplicação rodar atrás de HTTPS, para que os
# cookies de sessão só sejam enviados por conexões seguras.
SESSION_COOKIE_SECURE=0

# Tamanho máximo do corpo de uma requisição, em bytes (padrão: 1 MiB).
MAX_CONTENT_LENGTH=1048576
